# LiteSpeed / Apache: React Router pages (e.g. /booking, /admin/login) are served by
# index.html. Real files (assets, images) are served as they are.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
