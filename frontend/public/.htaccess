# LiteSpeed / Apache: React Router pages (e.g. /booking, /admin/login) are served by
# index.html. Real files (assets, images) are served as they are.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Live server: always HTTPS (localhost stays on http for development)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
