# Backend domain, no trailing slash (production build). Leave empty in dev — Vite proxies /api.
VITE_API_URL=

# Fallback only — the client key is normally set in the admin Settings page
VITE_MIDTRANS_CLIENT_KEY=

# Public site URL (no trailing slash) — used for the WhatsApp/Instagram link preview image
VITE_SITE_URL=http://localhost:5173
