APP_NAME="Poonya Studio"
APP_ENV=local
APP_KEY=
# Set APP_ENV=production and APP_DEBUG=false on the live server (debug pages leak config)
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

# Behind a reverse proxy / Cloudflare? List its IPs (or * if the app is ONLY reachable
# through it) so rate limits see each visitor's real IP. Leave empty when serving directly.
TRUSTED_PROXIES=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL is required — some migrations use MySQL-only ALTER statements
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=selfstudio
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email (Gmail SMTP). MAIL_PASSWORD = a 16-character Google *App Password*
# (Google Account -> Security -> 2-Step Verification -> App passwords), not the
# login password. Fill it in on the server only, never commit it.
# Emails are queued: run `php artisan queue:work`, and after editing this file
# `php artisan config:cache && php artisan queue:restart`.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=studiopoonya@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="studiopoonya@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Frontend origin (CORS) and where Midtrans redirects after payment
FRONTEND_URL=http://localhost:5173

# Midtrans — server key is secret and lives only here. Sandbox/Production and the
# client key are chosen in the admin Settings page; use the matching server key.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Xendit (alternative gateway, chosen in admin Settings). Secret key: Dashboard → Settings → API Keys
# (Money-in: Write). Callback token: Dashboard → Settings → Webhooks → Verification Token.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# Sender email can also be set from the admin Email page (overrides MAIL_* above)

# How long an admin login lasts, in minutes (default 7 days)
SANCTUM_EXPIRATION=10080

# First admin account created by `php artisan db:seed` (password is required, min 8 chars)
ADMIN_EMAIL=studiopoonya@gmail.com
ADMIN_PASSWORD=
